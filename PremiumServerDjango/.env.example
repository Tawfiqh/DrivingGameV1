# =============================================================================
# Core Django
# =============================================================================
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Settings module (leave unset for local dev; set for production/Railway)
# DJANGO_SETTINGS_MODULE=config.settings.production

# =============================================================================
# Database (base.py uses SQLite by default; override if needed)
# =============================================================================
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# =============================================================================
# App Store Server Integration
# =============================================================================
# Your app's bundle identifier (must match App Store Connect)
APPSTORE_BUNDLE_ID=com.yourcompany.getawayrun

# Numeric App Apple ID from App Store Connect (required for Production)
# APPSTORE_APP_APPLE_ID=123456789

# "Sandbox" or "Production"
APPSTORE_ENVIRONMENT=Sandbox

# Paths to Apple Root CA certificates in DER format.
# Download from https://www.apple.com/certificateauthority/
# APPSTORE_ROOT_CA_G3_PATH=/path/to/AppleRootCA-G3.cer
# APPSTORE_ROOT_CA_G2_PATH=/path/to/AppleRootCA-G2.cer

# Enable OCSP / online certificate checks (default: true)
# APPSTORE_ENABLE_ONLINE_CHECKS=true

# =============================================================================
# Production / Railway
# =============================================================================
# SECURE_SSL_REDIRECT=True

# Railway CLI deploy target (used by deploy.sh at repo root)
RAILWAY_PROJECT_ID=4e396fc0-68f2-4dfc-9032-ade8fbbf72fe
RAILWAY_ENVIRONMENT_ID=380b839b-8a6f-4222-ba4b-1627d05d716d
RAILWAY_SERVICE_ID=3e10d72d-590a-4508-a75d-6ae2b278522e
